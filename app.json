{
  "expo": {
    "name": "ClosetMesh",
    "slug": "ClosetMesh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ClosetMesh, hava durumuna göre stil önerileri sunabilmek için konumunuzu kullanır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ClosetMesh, kıyafetlerinizi gardırobunuza eklemek için fotoğraflarınıza erişir.",
          "cameraPermission": "ClosetMesh, kıyafet fotoğrafı çekmek için kameranızı kullanır.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
